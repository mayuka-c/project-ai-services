{
	admin 0.0.0.0:2019

	servers :443 {
		name {{ .CaddyServerName }}
	}

	servers :8443 {
		name private_mtls_ingress
	}

	servers :8080 {
		name private_mtls_egress
	}
}

:443 {
	# Seed the routes array so it is never empty at startup.
	handle /internal/health {
		# @id internal-health
		respond "OK" 200
	}

	tls internal
}

:8443 {
	handle /internal/health {
		# @id internal-mtls-health
		respond "OK" 200
	}

	tls /data/gateway-pki/server.crt /data/gateway-pki/server.key.pem {
		client_auth {
			mode require_and_verify
			trusted_ca_cert_file /data/gateway-pki/ca.crt
		}
	}
}

# Egress server: plain HTTP in, mTLS out to remote worker Caddy :8443.
# Routes are registered dynamically via the Admin API by the catalog process.
:8080 {
	handle /health {
		# @id internal-egress-health
		respond "OK" 200
	}
}

# Routes will be dynamically added via Caddy Admin API
