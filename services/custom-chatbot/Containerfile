FROM icr.io/ai-services-cicd/service-base:v0.0.34

WORKDIR /opt/services/custom-chatbot

ENV PYTHONPATH=/opt/services

COPY custom-chatbot/requirements.txt .
RUN source /var/venv/bin/activate && pip install -r requirements.txt && pip cache purge

COPY custom-chatbot/main.py .
COPY custom-chatbot/static/ ./static/

ENV PORT=8080 \
    LOG_LEVEL=INFO \
    LLM_ENDPOINT="" \
    LLM_MODEL="granite-3.3-8b-instruct" \
    LLM_API_KEY="" \
    LLM_MAX_TOKENS=1024 \
    SYSTEM_PROMPT=""

EXPOSE 8080

CMD ["/var/venv/bin/python", "-m", "uvicorn", "main:app", \
     "--host", "0.0.0.0", "--port", "8080", \
     "--loop", "uvloop", "--http", "httptools"]
